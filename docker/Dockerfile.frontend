# =============================================================================
# 前端 Dockerfile - 多阶段构建
# =============================================================================
FROM node:20-alpine AS build

WORKDIR /app

# 复制依赖文件
COPY frontend/package*.json ./

# 安装依赖
RUN npm install

# 复制前端源码
COPY frontend/ .

# 构建生产版本
RUN npm run build

# =============================================================================
# 生产阶段 - Nginx
# =============================================================================
FROM nginx:alpine

# 复制构建产物
COPY --from=build /app/dist /usr/share/nginx/html

# 复制 Nginx 配置
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
